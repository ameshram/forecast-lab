#!/usr/bin/env python3
"""PreToolUse hard gate for the Forecast Lab -- fail-closed edition.

Blocks (exit code 2 = deny, stderr shown to the agent):
  1. Edits to FROZEN files -- the evaluation harness and this governance layer
     itself. A changed metric or backtest invalidates every ledger row.
  2. Direct edits to PROTECTED ledger artifacts -- append-only, written
     exclusively through src/ledger.py / src/gates.py.
  3. Shell commands that mutate any of the above (broad write-verb coverage:
     redirects, cp, mv, rm, dd, tee, ln, install, patch, sed -i, perl -i,
     truncate, chmod/chown, and inline `python -c` writes).
  4. Running the Phase 1 final evaluation without the human sign-off file
     (experiments/PHASE1_SIGNOFF) -- Phase 1 is the locked test set.

Everything else is allowed (exit 0). Reads are never blocked.

FAIL-CLOSED CONTRACT (the point of this rewrite):
  Claude Code treats a hook exit of 1 (an uncaught exception) as a NON-blocking
  error -- so a hook that can throw silently enforces nothing. Here EVERY error
  path exits 2, never 1:
    * a too-old interpreter or a broken stdlib import exits 2;
    * unparseable stdin, or a well-formed event that is not a JSON object,
      exits 2 (the previous version exited 0 on malformed input -- fail-open);
    * any exception raised while evaluating the event exits 2.
  A well-formed event of an unrecognised shape is allowed (it is not a write to
  a protected path); only genuinely broken input fails closed.
"""
import sys

# Fail closed below the supported interpreter floor, before anything else runs.
if sys.version_info < (3, 8):
    sys.stderr.write(
        "BLOCKED by protect_frozen hook (fail-closed): Python >= 3.8 required, "
        "got %d.%d\n" % sys.version_info[:2])
    raise SystemExit(2)

try:
    import json
    import os
    import re
except Exception as exc:  # a broken interpreter must block, never error open
    sys.stderr.write(
        "BLOCKED by protect_frozen hook (fail-closed): broken hook "
        "environment: %s\n" % exc)
    raise SystemExit(2)

BLOCK = 2
ALLOW = 0

FROZEN = [
    "src/metrics.py",
    "src/backtest.py",
    "src/final_eval.py",
    ".claude/hooks/protect_frozen.py",
    ".claude/settings.json",
]
PROTECTED = [
    "experiments/ledger.csv",
    "experiments/champion.json",
    "experiments/gate_log.jsonl",
]
WRITE_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit", "Update", "ApplyPatch"}

# Any of these tokens signals a write-capable shell operation. Broader than the
# original {>, >>, tee, sed -i, rm, mv, truncate}: cp / python -c / dd / install
# / ln / patch used to overwrite a frozen file untouched. A verb match alone
# never denies -- the command must ALSO name a protected path -- so widening the
# set does not block unrelated writes.
SHELL_WRITE_RE = re.compile(
    r">>?|>\|"                          # redirections: >  >>  >|
    r"|\btee\b|\bdd\b|\btruncate\b"
    r"|\brm\b|\bmv\b|\bcp\b|\bln\b"
    r"|\binstall\b|\bpatch\b|\bchmod\b|\bchown\b"
    r"|\bsed\b[^|]*\s-i"                # sed in-place
    r"|\bperl\b[^|]*\s-i"               # perl in-place
    r"|\bpython[0-9.]*\b[^|]*\s-c\b"    # inline `python -c "...write..."`
)


def _as_dict(v):
    return v if isinstance(v, dict) else {}


def _norm(path):
    norm = str(path or "").replace("\\", "/")
    while norm.startswith("./"):
        norm = norm[2:]
    return norm


def _hits(norm, targets):
    """True if a normalised path is (or ends at) one of the protected paths."""
    for f in targets:
        if norm == f or norm.endswith("/" + f):
            return f
    return None


def deny(msg):
    sys.stderr.write("BLOCKED by protect_frozen hook: %s\n" % msg)
    raise SystemExit(BLOCK)


def evaluate(event):
    """Inspect one hook event; call deny() to block, return to allow.

    Any exception here is caught by main() and turned into a fail-closed block,
    so this function never needs its own defensive error handling.
    """
    tool = _as_dict(event).get("tool_name", "") or ""
    ti = _as_dict(_as_dict(event).get("tool_input", {}))

    if tool in WRITE_TOOLS:
        norm = _norm(ti.get("file_path") or ti.get("path")
                     or ti.get("notebook_path") or "")
        if _hits(norm, FROZEN):
            deny("%s is FROZEN (evaluation harness / governance). Changing it "
                 "invalidates the ledger. If the human has explicitly ordered a "
                 "harness change, they must lift the freeze by editing this hook "
                 "themselves." % _hits(norm, FROZEN))
        if _hits(norm, PROTECTED):
            deny("%s is append-only and written exclusively through "
                 "src/ledger.py or src/gates.py. Use those entry points."
                 % _hits(norm, PROTECTED))
        return

    if tool == "Bash":
        cmd = str(ti.get("command") or "")
        if SHELL_WRITE_RE.search(cmd):
            for f in FROZEN + PROTECTED:
                if f in cmd:
                    deny("shell command uses a write-capable operation on "
                         "protected file %s. Reads are fine via the Read tool; "
                         "writes must go through the blessed entry points." % f)
        if "final_eval" in cmd:
            root = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
            signoff = os.path.join(root, "experiments", "PHASE1_SIGNOFF")
            if not os.path.exists(signoff):
                deny("Phase 1 is LOCKED. src.final_eval may only run after the "
                     "human creates experiments/PHASE1_SIGNOFF to authorize the "
                     "one-shot final evaluation.")
        return


def main():
    try:
        event = json.load(sys.stdin)
    except Exception as exc:
        sys.stderr.write(
            "BLOCKED by protect_frozen hook (fail-closed): unparseable hook "
            "stdin (%s)\n" % exc)
        raise SystemExit(BLOCK)
    if not isinstance(event, dict):
        sys.stderr.write(
            "BLOCKED by protect_frozen hook (fail-closed): hook event is not a "
            "JSON object (got %s)\n" % type(event).__name__)
        raise SystemExit(BLOCK)
    try:
        evaluate(event)
    except SystemExit:
        raise                       # deny() already chose the (block) exit code
    except Exception as exc:        # any unforeseen error blocks, never exits 1
        sys.stderr.write(
            "BLOCKED by protect_frozen hook (fail-closed): internal error "
            "(%s)\n" % exc)
        raise SystemExit(BLOCK)
    raise SystemExit(ALLOW)


if __name__ == "__main__":
    main()
