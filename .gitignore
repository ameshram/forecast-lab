# Python environment
forecasting/
__pycache__/
*.pyc
.ipynb_checkpoints/

# OS
.DS_Store

# Local (machine-specific) Claude Code settings — shared settings.json IS tracked
.claude/settings.local.json

# Raw VN1 competition data is NOT redistributed with this repo (licensing;
# see README "Data source & citation"). Download it from the source and place
