data/

# Large per-run forecast dumps (regenerable); the ledger/metrics ARE tracked
experiments/runs/*/forecasts.parquet

# CatBoost training logs/tmp, written to the working dir during fit (regenerable)
catboost_info/

# Verbose training/run logs (regenerable build artifacts, machine-specific paths)
*.log
experiments/*.log

# Phase sign-off scratch (local working note, not a deliverable)
experiments/PHASE1_SIGNOFF
